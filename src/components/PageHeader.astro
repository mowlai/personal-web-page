---
/**
 * The masthead every tab shares: comment-style label, title, and a lede.
 * Keeping it in one component is what makes the tabs structurally identical —
 * same rhythm, same rule, same measure, whatever the page below it holds.
 */
interface Props {
  /** Route label shown as a shell comment, e.g. "publications". */
  label: string;
  title: string;
  /** Optional trailing count, e.g. "4 entries". */
  meta?: string;
}
const { label, title, meta } = Astro.props;
---

<header class="page-head" data-stream>
  <p class="eyebrow">{label}</p>
  <h1>{title}</h1>
  <p class="lede"><slot /></p>
  {meta && <p class="count">{meta}</p>}
</header>

<style>
  .count {
    font-size: .75rem;
    color: var(--gray-50);
    margin: var(--s-3) 0 0;
  }
  .count::before { content: '$ '; color: var(--gray-30); }
</style>
