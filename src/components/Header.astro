---
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

/** Nav labels render as filesystem paths: / , /publications , /projects … */
const asPath = (href: string) => (href === '/' ? '~' : href);
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={site.name}>
      <span class="brand__user">ryan</span><span class="brand__at">@</span><span
        class="brand__host">rmowlai</span><span class="brand__sym">:~$</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{asPath(item.href)}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, .93);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 56px;
  }

  /* Shell prompt: ryan@rmowlai:~$ */
  .brand {
    font-size: .875rem;
    letter-spacing: -0.01em;
    border: 0;
    white-space: nowrap;
  }
  .brand:hover { border: 0; }
  .brand__user { color: var(--text); font-weight: 600; }
  .brand__at,
  .brand__sym { color: var(--gray-50); }
  .brand__host { color: var(--accent); font-weight: 500; }
  .brand:hover .brand__host { color: var(--accent-hover); }

  .nav { display: flex; align-items: center; gap: var(--s-5); }
  .nav__link {
    position: relative;
    font-size: .8125rem;
    color: var(--text-muted);
    border: 0;
    padding-block: 1.05rem;
  }
  .nav__link:hover { color: var(--text); border: 0; }
  .nav__link.is-active { color: var(--accent); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--accent);
  }

  /* --- mobile --- */
  /* The checkbox stays sr-only rather than display:none so it remains
     keyboard-focusable and the menu can be opened without a pointer. */
  .nav-burger { display: none; }
  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; }
    .nav-burger {
      display: flex; flex-direction: column; justify-content: center; gap: 4px;
      width: 40px; height: 40px; cursor: pointer; padding: 8px;
    }
    .nav-burger span { display: block; height: 1.5px; background: var(--text); transition: .15s var(--ease); }
    .nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: var(--s-2);
    }
    .nav-toggle:checked ~ .nav { display: flex; }
    .nav__link { padding-block: .65rem; border-top: 1px solid var(--rule); }
    .nav__link.is-active::after { display: none; }
  }
</style>
