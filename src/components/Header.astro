---
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

/** Nav labels are plain lowercase words: home, publications, projects, … */
const label = (s: string) => s.toLowerCase();
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">{site.name}</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{label(item.label)}</a>
      ))}
      <div class="themes" role="group" aria-label="Theme">
        {['light', 'vscode', 'pycharm'].map((t) => (
          <button type="button" class="themes__btn" data-set-theme={t}>{t}</button>
        ))}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  /* Theme switcher: stores the choice and marks the active button. */
  (() => {
    const root = document.documentElement;
    const btns = document.querySelectorAll('[data-set-theme]');
    const mark = () => {
      const cur = root.getAttribute('data-theme') || 'light';
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === cur)));
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.setTheme;
      root.setAttribute('data-theme', t);
      try { localStorage.setItem('theme', t); } catch (e) { /* session only */ }
      mark();
    }));
    mark();
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 56px;
  }

  .brand {
    font-size: .875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    border: 0;
    white-space: nowrap;
  }
  .brand:hover { color: var(--accent); border: 0; }

  .nav { display: flex; align-items: center; gap: var(--s-5); }
  .nav__link {
    position: relative;
    font-size: .8125rem;
    color: var(--text-muted);
    border: 0;
    padding-block: 1.05rem;
  }
  .nav__link:hover { color: var(--text); border: 0; }
  .nav__link.is-active { color: var(--accent); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--accent);
  }

  .themes {
    display: flex;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .themes__btn {
    font: inherit;
    font-size: .6875rem;
    padding: .25rem .5rem;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .themes__btn + .themes__btn { border-left: 1px solid var(--rule); }
  .themes__btn:hover { color: var(--text); }
  .themes__btn[aria-pressed='true'] { color: var(--accent); background: var(--accent-wash); }

  /* --- mobile --- */
  /* The checkbox stays sr-only rather than display:none so it remains
     keyboard-focusable and the menu can be opened without a pointer. */
  .nav-burger { display: none; }
  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; }
    .nav-burger {
      display: flex; flex-direction: column; justify-content: center; gap: 4px;
      width: 40px; height: 40px; cursor: pointer; padding: 8px;
    }
    .nav-burger span { display: block; height: 1.5px; background: var(--text); transition: .15s var(--ease); }
    .nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: var(--s-2);
    }
    .nav-toggle:checked ~ .nav { display: flex; }
    .nav__link { padding-block: .65rem; border-top: 1px solid var(--rule); }
    .nav__link.is-active::after { display: none; }
    .themes { align-self: flex-start; margin-block: var(--s-3) var(--s-2); }
  }
</style>
