---
interface Props {
  href: string;
  title: string;
  summary: string;
  period: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
}
const { href, title, summary, period, tags = [], cover, coverAlt = '' } = Astro.props;
---
<article class="card">
  <a href={href} class="card__link" aria-label={title}>
    <div class="card__media">
      {cover
        ? <img src={cover} alt={coverAlt} loading="lazy" decoding="async" width="640" height="360" />
        : <div class="card__placeholder" aria-hidden="true"></div>}
    </div>
    <div class="card__body">
      <p class="meta card__period">{period}</p>
      <h3 class="card__title">{title}</h3>
      <p class="card__summary">{summary}</p>
      {tags.length > 0 && (
        <ul class="tags card__tags">
          {tags.slice(0, 4).map((t) => <li class="tag">{t}</li>)}
        </ul>
      )}
    </div>
  </a>
</article>

<style>
  .card { border: 1px solid var(--rule); background: var(--white); height: 100%; }
  .card__link {
    display: flex; flex-direction: column; height: 100%;
    color: inherit; border: 0;
    transition: border-color .11s var(--ease);
  }
  .card__link:hover { color: inherit; border: 0; }
  .card:has(.card__link:hover),
  .card:has(.card__link:focus-visible) { border-color: var(--accent); }
  .card:has(.card__link:hover) .card__title { color: var(--accent); }

  .card__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--gray-10); border-bottom: 1px solid var(--rule); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .2s var(--ease); }
  .card:has(.card__link:hover) .card__media img { transform: scale(1.02); }
  .card__placeholder {
    width: 100%; height: 100%;
    background:
      linear-gradient(135deg, var(--gray-10) 0%, var(--white) 55%, var(--accent-wash) 100%);
  }

  .card__body { padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); flex: 1; }
  .card__period { margin: 0; }
  .card__title { font-size: 1.0625rem; line-height: 1.3; transition: color .11s var(--ease); }
  .card__summary { font-size: .875rem; color: var(--text-secondary); margin: 0; flex: 1; }
  .card__tags { margin-top: var(--s-1); }
</style>
