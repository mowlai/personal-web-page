---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute-from-root path to a social preview image. */
  image?: string;
  type?: 'website' | 'article';
  /** The home page stands alone; every other page keeps the footer. */
  footer?: boolean;
}
const {
  title,
  description = site.description,
  image = '/images/ryan-mowlai.jpg',
  type = 'website',
  footer = true,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/ryan-mowlai.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <script is:inline>
      /* Runs before first paint: marks the document so [data-stream] blocks are
         hidden until the streaming script below has tokenized them. Skipped when
         the visitor prefers reduced motion, leaving the text plainly visible. */
      try {
        var mm = window.matchMedia;
        if (!(mm && mm('(prefers-reduced-motion: reduce)').matches)) {
          document.documentElement.classList.add('js-stream');
        }
      } catch (e) { /* leave the text plainly visible */ }
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      url: site.url,
      image: `${site.url}/images/ryan-mowlai.jpg`,
      affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Arizona' },
      sameAs: ['https://github.com/mowlai', 'https://linkedin.com/in/ryanmrm'],
    })} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    {footer && <Footer />}

    <script is:inline>
      /* Streams [data-stream] blocks in as if a terminal were printing them.
         Splits on whitespace so word wrapping is unaffected (splitting per
         character can introduce break opportunities mid-word), assigns each
         token an index, and lets CSS stagger the reveal. Text stays in the
         DOM the whole time, so crawlers and screen readers see it in full. */
      (() => {
        const root = document.documentElement;
        // Any failure below must not leave [data-stream] blocks hidden by the
        // head guard, so the whole thing unwinds to plainly visible text.
        const bail = () => root.classList.remove('js-stream');

        try {
        const blocks = document.querySelectorAll('[data-stream]');
        if (!blocks.length) return bail();

        let reduced = false;
        try {
          reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        } catch (e) { /* treat as no preference */ }

        let i = 0;
        blocks.forEach((block) => {
          block.classList.add('ready');
          // Walk text nodes only, so inline markup inside the block survives.
          // Skip raw-text containers: with scripting on, <noscript> holds its
          // markup as a text node, and tokenizing that would surface tags as text.
          const skip = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1 };
          const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) =>
              n.parentNode && skip[n.parentNode.nodeName]
                ? NodeFilter.FILTER_REJECT
                : NodeFilter.FILTER_ACCEPT,
          });
          const nodes = [];
          for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);

          nodes.forEach((node) => {
            const parts = node.nodeValue.split(/(\s+)/);
            if (parts.length === 1 && !parts[0].trim()) return;
            const frag = document.createDocumentFragment();
            parts.forEach((part) => {
              if (!part) return;
              if (!part.trim()) { frag.appendChild(document.createTextNode(part)); return; }
              const span = document.createElement('span');
              span.className = 'tok';
              span.style.setProperty('--i', String(i++));
              span.textContent = part;
              frag.appendChild(span);
            });
            node.parentNode.replaceChild(frag, node);
          });
        });

        if (reduced) { root.classList.add('no-stream'); return; }

        root.classList.add('streaming');
        // Mark done so trailing carets disappear once the last token lands.
        const step = 9, tail = 400;
        setTimeout(() => {
          root.classList.remove('streaming');
          root.classList.add('streamed');
        }, i * step + tail);
        } catch (e) { bail(); }
      })();
    </script>

    <script is:inline>
      /* Resolves .js-email links from their encoded token, on user intent only.
         See components/Email.astro. */
      (() => {
        const decode = (t) =>
          atob(t).replace(/[a-z]/g, (c) =>
            String.fromCharCode(((c.charCodeAt(0) - 97 + 13) % 26) + 97)
          );
        const scheme = ['ma', 'il', 'to'].join('') + String.fromCharCode(58);

        const arm = (el) => {
          if (el.dataset.armed) return;
          el.dataset.armed = '1';
          el.setAttribute('href', scheme + decode(el.dataset.e));
        };

        document.querySelectorAll('.js-email').forEach((el) => {
          ['mouseenter', 'focus', 'touchstart'].forEach((ev) =>
            el.addEventListener(ev, () => arm(el), { once: true, passive: true })
          );
          el.addEventListener('click', (e) => {
            if (!el.dataset.armed) {
              e.preventDefault();
              arm(el);
              location.href = el.getAttribute('href');
            }
          });
        });
      })();
    </script>
  </body>
</html>
