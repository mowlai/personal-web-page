---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { site, profiles } from '../data/site';

const featured = (await getCollection('projects', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date)
  .slice(0, 5);
---

<Base footer={false}>
  <div class="wrap home">
    <!-- Identity -->
    <div class="term term--plain" data-title="~ — whoami">
    <section class="intro" data-stream>
      <img
        class="intro__photo"
        src="/images/profile_picture_ryan.png"
        alt={`Portrait of ${site.name}`}
        width="360"
        height="360"
        fetchpriority="high"
        decoding="async"
      />

      <div>
        <h1 class="intro__name">{site.name}<span class="stream-caret" aria-hidden="true"></span></h1>
        <p class="intro__role">{site.role}</p>
        <div class="intro__education">
          <p class="intro__degree">
            PhD, <a href="https://sie.engineering.arizona.edu/" target="_blank" rel="noopener noreferrer">Systems and Industrial Engineering</a> at University of Arizona
          </p>
          <p class="intro__subline">
            Minor in Computer Science
            <!-- <a href="https://cs.arizona.edu/" target="_blank" rel="noopener noreferrer">Computer Science</a> -->
          </p>
          <p class="intro__subline">
            Research at CyPhyMan Lab and <a href="https://west.arizona.edu/" target="_blank" rel="noopener noreferrer">WEST Center</a> on <a href="https://www.wateresiliency.org/research-thrusts" target="_blank" rel="noopener noreferrer">Water Resiliency Program</a>
          </p>
          <p class="intro__degree intro__degree--second">
            MSc, <a href="https://corsidilaurea.uniroma1.it/en/course/33519" target="_blank" rel="noopener noreferrer">Data Science</a>,
            Sapienza University of Rome
          </p>
          <p class="intro__subline">
            Research at <a href="https://www.pinlab.org/" target="_blank" rel="noopener noreferrer">Perception and Intelligence Lab (PINlab)</a>
          </p>
        </div>
      </div>
    </section>
    </div>

    <!-- Summary -->
    <section class="summary term" data-title="~ — cat about.md" data-stream>
      <p class="summary__lead">
        Advancing AI for intelligent, adaptive, and autonomous physical systems.
      </p>
      <p>
        PhD researcher in machine learning at the University of Arizona, with over two
        years of industry experience. Research at the Cyber-Physical Manufacturing
        Systems Lab focuses on intelligent, self-correcting cyber-physical systems,
        combining predictive modeling, mathematical optimization, and reinforcement
        learning for decision-making and control. This work also explores foundation
        models and agentic AI for understanding physical dynamics, reasoning over
        multimodal data, and planning actions in real-world environments, with a
        primary focus on autonomous water treatment and collaborative research in
        additive manufacturing.
      </p>
      <p>
        Earlier research at the Perception and Intelligence Lab, under the supervision
        of <a href="https://www.fabiogalasso.org/" target="_blank" rel="noopener noreferrer">Dr. Fabio Galasso</a>,
        involved developing novel transformer-based Multi-Style Networks for human pose
        forecasting to anticipate collisions in human–robot collaboration.
      </p>
      <p>
        Industry experience spans end-to-end ML engineering, including propensity models
        integrated into an LLM-powered application for client behavioral segmentation
        and personalized recommendations at IBM, and multimodal deep learning models for
        spectroscopy-based drug detection at Lightsense Technology.
      </p>

      <nav class="links" aria-label="Profiles">
        {profiles.map((p) => (
          <a class="iconlink iconlink--lg" href={p.href} target="_blank" rel="noopener noreferrer">
            <Icon name={p.icon} size={14} />{p.label.toLowerCase()}
          </a>
        ))}
        <Email class="iconlink iconlink--lg"><Icon name="mail" size={14} />email</Email>
      </nav>
    </section>

    <!-- Selected work -->
    {featured.length > 0 && (
      <section class="work term" data-title="~/projects — ls">
        <div class="work__head">
          <h2 class="work__label">Selected Work</h2>
          <a class="work__all" href="/projects">/projects &rarr;</a>
        </div>

        <div class="work__list">
          {featured.map((p) => (
            <article class="work__item">
              <a class="work__link" href={`/projects/${p.id}/`}>
                <h3 class="work__title">{p.data.title}</h3>
                <p class="work__summary">{p.data.summary}</p>
                <span class="work__period">{p.data.period}</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .home {
    max-width: var(--page);
    padding-block: var(--s-9) var(--s-9);
  }
  @media (max-width: 640px) {
    .home { padding-block: var(--s-7) var(--s-8); }
  }

  /* ---------- Identity ---------- */
  .intro {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    margin-bottom: var(--s-7);
  }
  .intro__photo {
    width: 128px;
    height: 128px;
    flex: none;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 50%;
    /* Hairline ring plus a soft outer halo. */
    box-shadow:
      0 0 0 1px var(--rule-strong),
      0 0 0 8px var(--gray-10);
  }

  .intro__name {
    font-size: clamp(1.6rem, 1.2rem + 1.9vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--s-2);
  }
  .intro__role {
    font-size: .8125rem;
    letter-spacing: .02em;
    color: var(--accent);
    margin: 0 0 var(--s-2);
  }
  /* Renders as: > machine learning research scientist */
  .intro__role::before { content: '> '; color: var(--comment); }

  .intro__education {
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 76ch;
  }
  .intro__education p { margin: 0; }
  .intro__subline {
    padding-left: var(--s-4);
    color: var(--gray-50);
  }
  .intro__subline::before { content: '\21B3  '; color: var(--gray-30); }
  .intro__degree--second { margin-top: var(--s-1) !important; }
  .intro__education a {
    color: var(--text-secondary);
    border-bottom-color: var(--rule-strong);
  }
  .intro__education a:hover {
    color: var(--accent);
    border-bottom-color: currentColor;
  }

  @media (max-width: 560px) {
    .intro { flex-direction: column; align-items: flex-start; gap: var(--s-5); }
    .intro__photo { width: 104px; height: 104px; }
  }

  /* ---------- Summary ---------- */
  .summary {
    max-width: 780px;
  }
  .summary p {
    font-size: .9375rem;
    line-height: 1.85;
    color: var(--gray-90);
    margin: 0 0 var(--s-4);
    max-width: var(--measure);
    /* Justified so every line ends on the same right edge; hyphenation keeps
       word spacing even on narrow screens. */
    text-align: justify;
    hyphens: auto;
    /* Hanging rule down the left, like a quoted block in a terminal. */
    padding-left: var(--s-4);
    border-left: 2px solid var(--rule);
  }

  .summary p:last-of-type { margin-bottom: var(--s-5); }
  .summary .summary__lead { font-weight: 600; color: var(--text-strong); }

  /* Inside terminal panels the panels provide the spacing. */
  :global([data-theme]) .intro { margin-bottom: 0; }
  :global([data-theme]) .summary { max-width: none; }
  :global([data-theme]) .work { margin-top: 0; }

  .links { display: flex; flex-wrap: wrap; gap: var(--s-5); padding-left: var(--s-4); }

  /* ---------- Selected work ---------- */
  .work { margin-top: var(--s-8); }
  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .work__label {
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .06em;
    color: var(--text-muted);
    text-transform: lowercase;
  }
  .work__label::before { content: '// '; color: var(--comment); }
  .work__all { font-size: .75rem; color: var(--text-muted); white-space: nowrap; }
  .work__all:hover { color: var(--accent); }

  .work__list { border-bottom: 1px solid var(--rule); }
  .work__item { border-bottom: 1px solid var(--rule); }
  .work__item:last-child { border-bottom: 0; }
  .work__link {
    display: grid;
    grid-template-columns: minmax(230px, 1fr) minmax(160px, 1.8fr) max-content;
    align-items: baseline;
    gap: var(--s-4);
    min-width: 0;
    padding-block: var(--s-4);
    color: inherit;
    border: 0;
  }
  .work__link:hover { color: inherit; border: 0; }
  .work__title {
    overflow: hidden;
    font-size: .875rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color .11s var(--ease);
  }
  .work__link:hover .work__title { color: var(--accent); }
  .work__summary {
    min-width: 0;
    overflow: hidden;
    margin: 0;
    color: var(--text-muted);
    font-size: .75rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .work__period {
    color: var(--text-muted);
    font-size: .6875rem;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .work__link {
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: var(--s-1) var(--s-3);
    }
    .work__summary {
      grid-column: 1 / -1;
      white-space: normal;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>
