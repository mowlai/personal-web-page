---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { site, profiles } from '../data/site';

const featured = (await getCollection('projects', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date)
  .slice(0, 3);
---

<Base>
  <div class="wrap home">
    <!-- Identity -->
    <section class="intro">
      <img
        class="intro__photo"
        src="/images/ryan-mowlai.jpg"
        alt={`Portrait of ${site.name}`}
        width="360"
        height="360"
        fetchpriority="high"
        decoding="async"
      />

      <div class="intro__text">
        <h1 class="intro__name">{site.name}</h1>
        <p class="intro__role">{site.role}</p>
        <p class="intro__affil">{site.affiliation}</p>
      </div>
    </section>

    <!-- Summary -->
    <section class="summary">
      <p>
        I build machine learning systems that run physical infrastructure. My doctoral
        work, with the U.S. Army Corps of Engineers, develops reinforcement learning
        policies, time-series foundation models, and agentic controllers for autonomous
        water treatment. Previously: RL building-energy control in Milan, multimodal
        sensing at Lightsense, and LLM-driven audience modeling at IBM.
      </p>

      <nav class="links" aria-label="Profiles">
        {profiles.map((p) => (
          <a class="iconlink iconlink--lg" href={p.href} target="_blank" rel="noopener noreferrer">
            <Icon name={p.icon} size={15} />{p.label}
          </a>
        ))}
        <Email class="iconlink iconlink--lg"><Icon name="mail" size={15} />Email</Email>
      </nav>
    </section>

    <!-- Selected work -->
    {featured.length > 0 && (
      <section class="work">
        <div class="work__head">
          <h2 class="eyebrow">Selected work</h2>
          <a class="work__all" href="/projects">All projects &rarr;</a>
        </div>

        <ul class="work__list">
          {featured.map((p) => (
            <li>
              <a class="work__item" href={`/projects/${p.id}/`}>
                <span class="work__title">{p.data.title}</span>
                <span class="work__desc">{p.data.tagline ?? p.data.summary}</span>
                <span class="work__year">{p.data.period}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .home {
    max-width: 760px;
    padding-block: var(--s-10) var(--s-9);
  }
  @media (max-width: 640px) {
    .home { padding-block: var(--s-7) var(--s-8); }
  }

  /* ---------- Identity ---------- */
  .intro {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    margin-bottom: var(--s-7);
  }
  .intro__photo {
    width: 132px;
    height: 132px;
    flex: none;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 50%;
    /* Hairline ring plus a soft outer halo — the only ornament on the page. */
    box-shadow:
      0 0 0 1px var(--rule-strong),
      0 0 0 8px var(--gray-10);
  }
  .intro__name {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--s-2);
  }
  .intro__role {
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--s-2);
  }
  .intro__affil {
    font-size: .9375rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
    max-width: 42ch;
  }

  @media (max-width: 560px) {
    .intro { flex-direction: column; align-items: flex-start; gap: var(--s-5); }
    .intro__photo { width: 104px; height: 104px; }
  }

  /* ---------- Summary ---------- */
  .summary p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--gray-90);
    margin: 0 0 var(--s-5);
  }
  @media (max-width: 560px) {
    .summary p { font-size: 1.0625rem; }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }

  /* ---------- Selected work ---------- */
  .work { margin-top: var(--s-9); }
  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .work__head .eyebrow { margin: 0; }
  .work__all { font-size: .8125rem; color: var(--text-secondary); white-space: nowrap; }
  .work__all:hover { color: var(--accent); }

  .work__list { list-style: none; margin: 0; padding: 0; }
  .work__list li + li { border-top: 1px solid var(--gray-10); }

  /* One row per project: title, one-line description, period. */
  .work__item {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-3) var(--s-4) 0;
    color: inherit;
    border: 0;
    /* Accent bar slides in from the left edge on hover. */
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 100%;
    background-repeat: no-repeat;
    background-position: left center;
    transition: background-size .16s var(--ease), padding-left .16s var(--ease);
  }
  .work__item:hover,
  .work__item:focus-visible {
    color: inherit;
    border: 0;
    background-size: 2px 100%;
    padding-left: var(--s-4);
  }
  .work__title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color .11s var(--ease);
  }
  .work__item:hover .work__title { color: var(--accent); }
  .work__desc {
    font-size: .9rem;
    color: var(--text-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .work__year {
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--gray-50);
    white-space: nowrap;
  }

  /* Below the fold for one line: stack title/description, keep the year inline. */
  @media (max-width: 720px) {
    .work__item {
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: var(--s-1) var(--s-4);
      padding-block: var(--s-3);
    }
    .work__title { grid-column: 1; }
    .work__year { grid-column: 2; grid-row: 1; }
    .work__desc {
      grid-column: 1 / -1;
      white-space: normal;
      overflow: visible;
      line-height: 1.5;
    }
  }
</style>
