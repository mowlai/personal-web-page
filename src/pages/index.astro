---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { site, profiles } from '../data/site';

const featured = (await getCollection('projects', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date)
  .slice(0, 3);
---

<Base footer={false}>
  <div class="wrap home">
    <!-- Identity -->
    <section class="intro" data-stream>
      <img
        class="intro__photo"
        src="/images/ryan-mowlai.jpg"
        alt={`Portrait of ${site.name}`}
        width="360"
        height="360"
        fetchpriority="high"
        decoding="async"
      />

      <div>
        <h1 class="intro__name">{site.name}<span class="stream-caret" aria-hidden="true"></span></h1>
        <p class="intro__role">{site.role}</p>
        <p class="intro__affil">{site.affiliation}</p>
      </div>
    </section>

    <!-- Summary -->
    <section class="summary" data-stream>
      <p>
        I am a PhD candidate in Systems and Industrial Engineering with a minor in
        Computer Science at the University of Arizona, where I work as a research
        assistant in Cyber-Physical Manufacturing Systems. My doctoral research
        brings together state-aware optimization, reinforcement learning, and agentic
        AI for autonomous water treatment as part of the
        <a href="https://www.wateresiliency.org/research-thrusts" target="_blank" rel="noopener noreferrer">WateResiliency project funded by the U.S. Army Corps of Engineers</a>.
      </p>

      <section class="research-questions" aria-labelledby="research-questions-title">
        <h2 id="research-questions-title">Core Dissertation Research Questions</h2>
        <h3>RQ1 — State-Aware Optimization</h3>
        <p>
          How can heterogeneous operational history, membrane condition, water quality,
          and controllable operating variables be transformed into predictive response
          models and state-dependent optimal operating decisions?
        </p>
        <h3>RQ2 — Reinforcement Learning and Adaptive Control</h3>
        <p>
          How can autonomous water treatment systems learn long-horizon operating and
          cleaning policies that balance water production, fouling, energy, chemical
          usage, downtime, and physical constraints?
        </p>
        <h3>RQ3 — Agentic AI for Cyber-Physical Systems</h3>
        <p>
          How can tool-augmented language agents integrate predictive models,
          optimization, reinforcement-learning policies, operational knowledge, and
          safety verification to provide reliable and explainable decision support
          for dynamic cyber-physical systems?
        </p>
      </section>

      <p>
        I earned my master's in Data Science at Sapienza University of Rome, focusing
        on computer vision. My research adapted transformer-based Multi-Style Networks
        to predict human poses, with the goal of preventing human–robot collisions in
        human–robot collaboration systems. This work led to a publication at IEEE SIEDS.
        I also have extensive experience in vision-language modeling, including work
        during a Google training camp at Sapienza, alongside a broader portfolio of
        data science and machine learning projects.
      </p>
      <p>
        My internships and industry experience span statistical modeling, deep
        learning, and deployed AI systems. At IBM, I worked on large-scale propensity
        modeling and LLM applications. At Lightsense Technology, I worked on multimodal
        deep learning and adversarial evaluation. At DIDO Srl in Milan, I worked on
        PPO-based building energy optimization deployed on AWS.
      </p>

      <nav class="links" aria-label="Profiles">
        {profiles.map((p) => (
          <a class="iconlink iconlink--lg" href={p.href} target="_blank" rel="noopener noreferrer">
            <Icon name={p.icon} size={14} />{p.label.toLowerCase()}
          </a>
        ))}
        <Email class="iconlink iconlink--lg"><Icon name="mail" size={14} />email</Email>
      </nav>
    </section>

    <!-- Selected work -->
    {featured.length > 0 && (
      <section class="work">
        <div class="work__head">
          <h2 class="work__label">selected work</h2>
          <a class="work__all" href="/projects">/projects &rarr;</a>
        </div>

        <ul class="work__list">
          {featured.map((p) => (
            <li>
              <a class="work__item" href={`/projects/${p.id}/`}>
                <span class="work__title">{p.data.title}</span>
                <span class="work__desc">{p.data.tagline ?? p.data.summary}</span>
                <span class="work__year">{p.data.period}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .home {
    max-width: 780px;
    padding-block: var(--s-9) var(--s-9);
  }
  @media (max-width: 640px) {
    .home { padding-block: var(--s-7) var(--s-8); }
  }

  /* ---------- Identity ---------- */
  .intro {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    margin-bottom: var(--s-7);
  }
  .intro__photo {
    width: 128px;
    height: 128px;
    flex: none;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 50%;
    /* Hairline ring plus a soft outer halo. */
    box-shadow:
      0 0 0 1px var(--rule-strong),
      0 0 0 8px var(--gray-10);
  }

  .intro__name {
    font-size: clamp(1.6rem, 1.2rem + 1.9vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--s-2);
  }
  .intro__role {
    font-size: .8125rem;
    letter-spacing: .02em;
    color: var(--accent);
    margin: 0 0 var(--s-2);
  }
  /* Renders as: > machine learning research scientist */
  .intro__role::before { content: '> '; color: var(--gray-30); }

  .intro__affil {
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
    max-width: 46ch;
  }

  @media (max-width: 560px) {
    .intro { flex-direction: column; align-items: flex-start; gap: var(--s-5); }
    .intro__photo { width: 104px; height: 104px; }
  }

  /* ---------- Summary ---------- */
  .summary p {
    font-size: .9375rem;
    line-height: 1.85;
    color: var(--gray-90);
    margin: 0 0 var(--s-4);
    max-width: var(--measure);
    /* Hanging rule down the left, like a quoted block in a terminal. */
    padding-left: var(--s-4);
    border-left: 2px solid var(--rule);
  }

  .summary p:last-of-type { margin-bottom: var(--s-5); }

  .research-questions { margin-block: var(--s-6); }
  .research-questions h2 {
    font-size: 1rem;
    margin-bottom: var(--s-4);
    padding-left: var(--s-4);
  }
  .research-questions h3 {
    font-size: .9375rem;
    line-height: 1.6;
    margin-bottom: var(--s-2);
    padding-left: var(--s-4);
  }

  .links { display: flex; flex-wrap: wrap; gap: var(--s-5); padding-left: var(--s-4); }

  /* ---------- Selected work ---------- */
  .work { margin-top: var(--s-8); }
  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .work__label {
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .06em;
    color: var(--text-muted);
  }
  .work__label::before { content: '// '; color: var(--gray-30); }
  .work__all { font-size: .75rem; color: var(--text-muted); white-space: nowrap; }
  .work__all:hover { color: var(--accent); }

  .work__list { list-style: none; margin: 0; padding: 0; }
  .work__list li + li { border-top: 1px solid var(--gray-10); }

  /* One row per project: title, one-line description, period. */
  .work__item {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-3) var(--s-4) 0;
    color: inherit;
    border: 0;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 100%;
    background-repeat: no-repeat;
    background-position: left center;
    transition: background-size .16s var(--ease), padding-left .16s var(--ease);
  }
  .work__item:hover,
  .work__item:focus-visible {
    color: inherit;
    border: 0;
    background-size: 2px 100%;
    padding-left: var(--s-4);
  }
  .work__title {
    font-size: .9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    transition: color .11s var(--ease);
  }
  .work__item:hover .work__title { color: var(--accent); }
  .work__desc {
    font-size: .8125rem;
    color: var(--text-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .work__year {
    font-size: .75rem;
    color: var(--gray-50);
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .work__item {
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: var(--s-1) var(--s-4);
      padding-block: var(--s-3);
    }
    .work__title { grid-column: 1; }
    .work__year { grid-column: 2; grid-row: 1; }
    .work__desc {
      grid-column: 1 / -1;
      white-space: normal;
      overflow: visible;
      line-height: 1.6;
    }
  }
</style>
