---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.summary} image={d.cover} type="article">
  <article class="wrap page">
    <header class="page-head" data-stream>
      <a class="back" href="/projects">&larr; projects</a>
      <p class="eyebrow">{d.period}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {d.tags.length > 0 && (
        <ul class="tags head__tags">
          {d.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      )}

      {d.links.length > 0 && (
        <div class="actions">
          {d.links.map((l) => (
            <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
              <Icon name={l.icon} size={13} />{l.label}
            </a>
          ))}
        </div>
      )}
    </header>

    {d.cover && (
      <figure class="cover">
        <img src={d.cover} alt={d.coverAlt} loading="eager" decoding="async" />
        {d.coverAlt && <figcaption>{d.coverAlt}</figcaption>}
      </figure>
    )}

    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font-size: .8125rem;
    color: var(--text-secondary);
    margin-bottom: var(--s-4);
    border: 0;
  }
  .back:hover { color: var(--accent); border: 0; }
  .head__tags { margin: var(--s-4) 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }

  .cover { margin: 0 0 var(--s-6); }
  .cover img { width: 100%; border: 1px solid var(--rule); }
</style>
