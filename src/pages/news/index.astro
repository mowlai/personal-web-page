---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

const items = (await getCollection('news', (n) => !n.data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="News" description="Awards, talks, papers, and milestones from Ryan Mowlai.">
  <div class="wrap page">
    <PageHeader label="news" title="News" meta={`${items.length} entries`}>
      Awards, talks, papers, and milestones, newest first.
    </PageHeader>

    {items.length === 0 ? (
      <p class="empty">Nothing posted yet.</p>
    ) : (
      <ul class="list">
        {items.map((n) => {
          const href = n.data.href ?? `/news/${n.id}/`;
          const external = Boolean(n.data.href);
          return (
            <li class="item">
              <div class="item__rail">
                <time class="meta" datetime={n.data.date.toISOString().slice(0, 10)}>
                  {fmt(n.data.date)}
                </time>
              </div>
              {n.data.cover && (
                <a class="item__thumb" href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} tabindex="-1" aria-hidden="true">
                  <img src={n.data.cover} alt={n.data.coverAlt} loading="lazy" decoding="async" />
                </a>
              )}
              <div class="item__body">
                <h2 class="item__title">
                  <a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {n.data.title}
                  </a>
                </h2>
                <p class="item__summary">{n.data.summary}</p>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Base>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .item {
    display: grid;
    grid-template-columns: 150px 160px 1fr;
    gap: var(--s-5);
    align-items: start;
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  /* No thumbnail: let the body span the media column too. */
  .item:not(:has(.item__thumb)) { grid-template-columns: 150px 1fr; }

  .item__rail { padding-top: 3px; }
  .item__thumb { display: block; border: 1px solid var(--rule); overflow: hidden; }
  .item__thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .item__title { font-size: 1.0625rem; line-height: 1.35; margin-bottom: var(--s-2); }
  .item__title a { color: var(--text); border: 0; }
  .item__title a:hover { color: var(--accent); border: 0; }
  .item__summary { font-size: .9375rem; color: var(--text-secondary); max-width: var(--measure); margin: 0; }
  .empty { color: var(--text-muted); }

  @media (max-width: 760px) {
    .item,
    .item:not(:has(.item__thumb)) { grid-template-columns: 1fr; gap: var(--s-3); }
    .item__thumb { max-width: 280px; }
  }
</style>
