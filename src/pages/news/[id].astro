---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  // Items that only point elsewhere (href set) get no page of their own.
  const items = await getCollection('news', (n) => !n.data.draft && !n.data.href);
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={d.title} description={d.summary} image={d.cover} type="article">
  <article class="wrap page">
    <a class="back" href="/news">&larr; News</a>
    <time class="meta" datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time>
    <h1>{d.title}</h1>
    <p class="summary">{d.summary}</p>

    {d.cover && (
      <figure class="cover">
        <img src={d.cover} alt={d.coverAlt} decoding="async" />
        {d.coverAlt && <figcaption>{d.coverAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page { padding-block: var(--s-7) var(--s-6); max-width: 820px; }
  .back {
    display: inline-block;
    font-size: .8125rem;
    color: var(--text-secondary);
    margin-bottom: var(--s-4);
    border: 0;
  }
  .back:hover { color: var(--accent); border: 0; }
  h1 { margin: var(--s-2) 0 var(--s-3); }
  .summary { font-size: 1.0625rem; color: var(--text-secondary); max-width: var(--measure); }
  .cover { margin: var(--s-5) 0 var(--s-6); }
  .cover img { width: 100%; border: 1px solid var(--rule); }
</style>
