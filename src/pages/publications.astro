---
import Base from '../layouts/Base.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { publications } from '../data/publications';

// Reverse-chronological, grouped by year. `year` may be a string for
// forthcoming work, so coerce for the sort only.
const byYear = new Map<number | string, typeof publications>();
for (const p of publications) {
  const list = byYear.get(p.year) ?? [];
  list.push(p);
  byYear.set(p.year, list);
}
const years = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
const count = publications.length;
---

<Base
  title="Publications"
  description="Peer-reviewed papers, preprints, and manuscripts in preparation by Ryan Mowlai."
>
  <section class="section wrap">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
    <p class="lede">
      {count} entries, newest first. Every item carries a direct link to the PDF or
      preprint where one is available, and a one-click BibTeX citation.
    </p>

    {years.map((y) => (
      <div class="year-block">
        <h2 class="year-heading">{y}</h2>
        {byYear.get(y)!.map((pub) => <PublicationEntry pub={pub} />)}
      </div>
    ))}
  </section>
</Base>

<style>
  h1 { margin-bottom: var(--s-3); }
  .lede {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: var(--measure);
    margin-bottom: var(--s-7);
  }
  .year-block + .year-block { margin-top: var(--s-7); }
  .year-heading {
    font-family: var(--font-mono);
    font-size: .8125rem;
    font-weight: 500;
    letter-spacing: .08em;
    color: var(--text-muted);
    padding-bottom: var(--s-2);
    border-bottom: 2px solid var(--gray-100);
  }
</style>
